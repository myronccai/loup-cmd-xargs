@mode(host.dual)

from appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.args import (Options, parse_args);
from cli.usage import (usage, version_line);
from commands.xargs import (run_xargs);

# Parses argv, runs xargs and returns the exit status.
pub func run(argv: list[string]): int {
    let parsed = parse_args(argv);
    if (parsed.is_err()) {
        let msg = parsed.unwrap_err();
        printErr(i"{$ APP_NAME $}: {$ msg $}");
        # GNU xargs adds the hint to option errors, not to a bad -d value.
        if (!msg.startsWith("Invalid ")) {
            printErr(i"Try '{$ APP_NAME $} --help' for more information.");
        }
        return EXIT_USAGE;
    }
    let opts = parsed.unwrap();

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }
    for (w in opts.warnings) {
        printErr(i"{$ APP_NAME $}: {$ w $}");
    }

    try {
        return run_xargs(opts);
    } catch (Exception as e) {
        printErr(i"{$ APP_NAME $}: {$ e.message $}");
        return EXIT_FAILURE;
    }
}
